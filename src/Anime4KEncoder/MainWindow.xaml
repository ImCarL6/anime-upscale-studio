<Window x:Class="Anime4KEncoder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anime Upscale Studio" Height="880" Width="1320" MinHeight="760" MinWidth="1080"
        WindowStartupLocation="CenterScreen" Background="#090D15" Foreground="#EDF2FA">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#121927"/>
        <SolidColorBrush x:Key="Panel2" Color="#182235"/>
        <SolidColorBrush x:Key="Border" Color="#2A3850"/>
        <SolidColorBrush x:Key="Accent" Color="#806BFF"/>
        <SolidColorBrush x:Key="Muted" Color="#99A8BD"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2A3850"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#202C40"/>
            <Setter Property="Foreground" Value="#101827"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1420"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="9,7"/>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="Background" Value="#263246"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#182235"/>
            <Setter Property="Foreground" Value="#BDC9DA"/>
            <Setter Property="BorderBrush" Value="#2A3850"/>
            <Setter Property="Padding" Value="10,9"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#EDF2FA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Anime Upscale Studio" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Anime4K e AnimeJaNai • AV1 NVENC • NVIDIA RTX" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,5,0,0"/>
                <Border x:Name="TensorRtNotice" Visibility="Collapsed" Background="#24354D" CornerRadius="6" Padding="10" Margin="0,8,12,0" MaxWidth="660" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="Preparando TensorRT para sua placa de vídeo" FontWeight="SemiBold" Foreground="#8CCBFF"/>
                        <TextBlock x:Name="TensorRtNoticeText" TextWrapping="Wrap" Margin="0,4,0,6"/>
                        <ProgressBar IsIndeterminate="True" Height="4"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Button x:Name="UpdatesButton" Content="Atualizações e novidades" Click="Updates_Click" Padding="10,5"/>
                    <TextBlock x:Name="UpdateStatusText" VerticalAlignment="Center" Foreground="{StaticResource Muted}" TextWrapping="Wrap" MaxWidth="450"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,9">
                <StackPanel>
                    <TextBlock x:Name="ToolsStatusText" Text="Verificando ambiente…" Foreground="#F7C76A"/>
                    <CheckBox x:Name="AdvancedModeCheck" Content="Modo avançado" Foreground="#F7C76A" Margin="0,8,0,0" Click="AdvancedMode_Click"/>
                    <CheckBox x:Name="BetaModeCheck" Content="Parâmetros beta" Foreground="#D99BFF" Margin="0,6,0,0" Click="BetaMode_Click"
                              ToolTip="Ativa somente opções experimentais. O histórico e o aprendizado beta ficam separados do modo estável."/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1.8*"/><ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="0.45*"/><ColumnDefinition Width="0.62*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock Text="Processamento" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="EngineCombo" DisplayMemberPath="Name" SelectionChanged="EngineCombo_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock x:Name="ProfileLabel" Text="Shader / modelo" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ProfileCombo" DisplayMemberPath="Name" SelectionChanged="ProfileCombo_SelectionChanged"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <TextBlock Text="Pasta de saída" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="OutputDirectoryText" ToolTip="Vazio = mesma pasta do arquivo" TextChanged="Settings_Changed"/>
                        <Button Grid.Column="1" Content="…" Width="42" Margin="7,0,0,0" Click="ChooseOutput_Click"/>
                    </Grid>
                    <TextBlock x:Name="OutputDiskSpaceText" Text="Espaço livre: aguardando pasta" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,14,0">
                    <TextBlock Text="CQ" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                    <TextBox x:Name="CqText" Text="28" HorizontalContentAlignment="Center" TextChanged="Settings_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Simultâneos" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="ConcurrencyCombo" SelectedIndex="1">
                        <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#102018" BorderBrush="#285840" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="0.85*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Perfil de reprodução: Jellyfin + Fire TV Stick 4K Max (2ª geração)" FontWeight="SemiBold" Foreground="#8FE0AE"/>
                    <TextBlock x:Name="CompatibilitySummaryText" Text="AV1 Main 10-bit, 4K, MKV e AAC 48 kHz. Legendas ASS podem exigir transcodificação." Foreground="#B8C8BF" Margin="0,4,0,0"/>
                    <Border x:Name="LegacyProfileWarningPanel" Visibility="Collapsed" Background="#2C2312" BorderBrush="#B8893B" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="LegacyProfileWarningTitle" Text="⚠ Perfil Legacy/Experimental" Foreground="#F7C76A" FontWeight="SemiBold"
                                       AutomationProperties.Name="Aviso Legacy/Experimental visível"/>
                            <TextBlock x:Name="LegacyProfileWarningText" Foreground="#E7D3A9" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="AdvancedPanel" Visibility="Collapsed" Background="#241D12" BorderBrush="#8A6A2F" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Comando FFmpeg editável • use {INPUT} e {OUTPUT} como marcadores" Foreground="#F7C76A" FontWeight="SemiBold"/>
                            <TextBox x:Name="AdvancedCommandText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="72" MaxHeight="150" Margin="0,7,0,0" FontFamily="Consolas" FontSize="11" TextChanged="AdvancedCommandText_Changed"/>
                            <TextBlock Text="O ffmpeg.exe permanece fixo. No AnimeJaNai, o Modo avançado usa o fluxo contínuo e desativa a retomada por blocos." Foreground="#D5B979" FontSize="11" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="BetaPanel" Visibility="Collapsed" Background="#21152B" BorderBrush="#74418F" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Parâmetros experimentais beta" Foreground="#D99BFF" FontWeight="SemiBold"/>
                            <WrapPanel Margin="0,7,0,0">
                                <CheckBox x:Name="BetaLookaheadCheck" Content="Lookahead 4" Foreground="#F0DFFF" Margin="0,0,14,5" Click="BetaOption_Click"
                                          ToolTip="Aumenta o nível de análise antecipada do NVENC. Pode melhorar a distribuição de bits, mas aumenta uso da GPU e tempo de encode."/>
                                <CheckBox x:Name="BetaAqStrengthCheck" Content="AQ strength 10" Foreground="#F0DFFF" Margin="0,0,14,5" Click="BetaOption_Click"
                                          ToolTip="Aumenta a força da alocação adaptativa espacial. Pode preservar detalhes em cenas difíceis, mas tende a aumentar o tamanho do arquivo."/>
                                <CheckBox x:Name="BetaBAdaptCheck" Content="B-adapt" Foreground="#F0DFFF" Margin="0,0,14,5" Click="BetaOption_Click"
                                          ToolTip="Permite ao encoder decidir melhor a estrutura de frames B. Pode melhorar eficiência, com pequeno custo de análise."/>
                                <CheckBox x:Name="BetaBRefCheck" Content="B-frames como referência" Foreground="#F0DFFF" Margin="0,0,14,5" Click="BetaOption_Click"
                                          ToolTip="Usa frames B como referência hierárquica. Pode melhorar compressão, mas deve ser validado no Jellyfin e no Fire TV."/>
                                <CheckBox x:Name="BetaWeightedPredCheck" Content="Weighted prediction" Foreground="#F0DFFF" Margin="0,0,14,5" Click="BetaOption_Click"
                                          ToolTip="Ativa predição ponderada. Pode ajudar em transições e mudanças de iluminação, com possível aumento de complexidade."/>
                            </WrapPanel>
                            <TextBlock Text="Essas opções não alteram o modo estável. Cada combinação beta aprende separadamente." Foreground="#D5B979" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="EstimateSummaryText" Text="Estimativa: aguardando arquivos" TextWrapping="Wrap" Foreground="#C7D1E0"/>
                    <Border x:Name="PilotSummaryPanel" Visibility="Collapsed" Background="#15263A" BorderBrush="#3B6F9D" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Piloto medido" Foreground="#8CCBFF" FontWeight="SemiBold"/>
                                <Button x:Name="OpenPilotButton" Content="Abrir amostra" HorizontalAlignment="Right" Padding="10,4" Margin="0" Click="OpenPilot_Click"/>
                            </Grid>
                            <TextBlock x:Name="PilotSummaryText" Foreground="#D7E9F8" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
                            <Button x:Name="ComparePilotButton" Content="Comparar original e resultado" IsEnabled="False" Click="ComparePilot_Click" HorizontalAlignment="Left" Margin="0,7,0,0" Padding="10,4"/>
                            <TextBlock Text="Tempo com margem de ±15%; a preparação da engine é feita antes da medição." Foreground="#96AEC2" TextWrapping="Wrap" FontSize="10" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="1">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="16,13">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Fila de episódios" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="Arraste pelo ⋮⋮ para ordenar antes de iniciar a fila." Foreground="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Adicionar arquivos" Background="{StaticResource Accent}" Click="AddFiles_Click"/>
                        <Button Content="Remover selecionados" Click="RemoveSelected_Click"/>
                        <Button Content="Limpar" Click="Clear_Click" Margin="0"/>
                    </StackPanel>
                </Grid>
                <DataGrid x:Name="QueueGrid" Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserSortColumns="False" AllowDrop="True" DragOver="QueueGrid_DragOver" Drop="QueueGrid_Drop"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Extended" BorderThickness="0"
                          Background="#0E141F" Foreground="#EDF2FA" RowBackground="#0E141F" AlternatingRowBackground="#111A28"
                          HorizontalGridLinesBrush="#222E40" ColumnHeaderStyle="{StaticResource GridHeader}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="30" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <TextBlock Text="⋮⋮" Cursor="SizeAll" FontSize="18" Padding="4" VerticalAlignment="Center"
                                           ToolTip="Arraste para mudar a posição na fila" PreviewMouseLeftButtonDown="QueueHandle_MouseDown" PreviewMouseMove="QueueHandle_MouseMove"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Arquivo" Binding="{Binding FileName}" Width="2.3*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Duração" Binding="{Binding DurationText}" Width="0.55*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Tempo decorrido" Binding="{Binding ElapsedText}" Width="0.82*" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Estimativa" Width="0.72*" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EstimatedSizeText}" ToolTip="{Binding EstimateBasis}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Tamanho final" Width="0.78*" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ActualSizeText}" ToolTip="{Binding SizeComparisonText}" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Progresso" Width="1.35*" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="6,7">
                                <ProgressBar Value="{Binding Progress}" Maximum="100"/>
                                <TextBlock Text="{Binding ProgressText}" Foreground="#B7C3D4" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="ETA" Binding="{Binding EtaText}" Width="0.65*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="0.9*" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Resultado" Width="118" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="▶" ToolTip="Abrir vídeo final" Padding="9,5" Margin="2" IsEnabled="{Binding CanOpenOutput}" Click="OpenOutput_Click"/>
                                    <Button Content="Pasta" ToolTip="Mostrar o vídeo final na pasta" Padding="7,5" Margin="2" IsEnabled="{Binding CanOpenOutput}" Click="OpenOutputFolder_Click"/>
                                </StackPanel>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Jellyfin" Binding="{Binding Compatibility}" Width="0.95*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource Panel2}" CornerRadius="10" Padding="16" Margin="0,16,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <Grid><TextBlock Text="Progresso total" FontWeight="SemiBold"/><TextBlock x:Name="OverallPercentText" Text="0%" HorizontalAlignment="Right"/></Grid>
                    <ProgressBar x:Name="OverallProgress" Margin="0,9,0,0" Maximum="100" Height="10"/>
                    <TextBlock x:Name="OverallStatusText" Text="Pronto para começar" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="LogsButton" Content="Abrir logs" Click="OpenLogs_Click"/>
                    <Button x:Name="PilotButton" Content="Executar piloto" Background="#315F86" FontWeight="SemiBold" Click="Pilot_Click"
                            ToolTip="Mede três trechos de 5 segundos com o motor, perfil e CQ selecionados."/>
                    <Button x:Name="StartButton" Content="Iniciar fila" Background="{StaticResource Accent}" FontWeight="SemiBold" Click="Start_Click"/>
                    <Button x:Name="CancelButton" Content="Cancelar" IsEnabled="False" Click="Cancel_Click" Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="5" x:Name="FooterText" Foreground="{StaticResource Muted}" FontSize="12"
                   Text="Arquivos temporários usam .partial.mkv e o original nunca é alterado."/>
    </Grid>
</Window>
