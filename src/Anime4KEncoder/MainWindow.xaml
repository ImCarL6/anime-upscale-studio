<Window x:Class="Anime4KEncoder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anime Upscale Studio" Height="880" Width="1360" MinHeight="640" MinWidth="1040"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <!-- Também mesclado aqui para a janela funcionar sem App (scripts Test-*.ps1). -->
    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml"/>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Grid Grid.Row="0" Margin="20,12,20,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Anime Upscale Studio" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button x:Name="UpdatesButton" Click="Updates_Click" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Padding="8,4"
                        ToolTip="Atualizações e novidades">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" Style="{StaticResource IconLabel}" FontSize="12" Margin="0,1,6,0"/>
                        <TextBlock x:Name="UpdateStatusText" FontSize="12" MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Grid.Column="1" x:Name="ToolsStatusText" Text="Verificando ambiente…" Foreground="{StaticResource WarningBrush}" FontSize="12"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,16,0" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Uso do PC" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="2"
                        ToolTip="{Binding Text, ElementName=ResourceStatusText}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ResourceWatchRadio" Tag="0" Content="Assistir" GroupName="ResourceMode" Style="{StaticResource SegmentButton}"
                                     Checked="ResourceSegment_Checked" ToolTip="Trabalhar e assistir: CPU limitada, ritmo reduzido, blocos de 1 min. Pode trocar durante o processamento."/>
                        <RadioButton x:Name="ResourceBalancedRadio" Tag="1" Content="Equilibrado" GroupName="ResourceMode" Style="{StaticResource SegmentButton}"
                                     Checked="ResourceSegment_Checked" ToolTip="Equilibrado (padrão): blocos de 3 min. Pode trocar durante o processamento."/>
                        <RadioButton x:Name="ResourceMaxRadio" Tag="2" GroupName="ResourceMode" Style="{StaticResource SegmentButton}"
                                     Checked="ResourceSegment_Checked" ToolTip="Desempenho máximo: sem limite de CPU, blocos de 5 min. A proteção de memória continua ativa.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="0,1,5,0"/>
                                <TextBlock Text="Máximo"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <!-- Controles originais: continuam sendo a fonte do modo (código e scripts de teste). -->
                <ComboBox x:Name="ResourceModeCombo" Visibility="Collapsed" SelectedIndex="1" SelectionChanged="ResourceMode_Changed">
                    <ComboBoxItem Content="Trabalhar e assistir • blocos de 1 min"/>
                    <ComboBoxItem Content="Equilibrado (padrão) • blocos de 3 min"/>
                    <ComboBoxItem Content="Desempenho máximo • blocos de 5 min"/>
                </ComboBox>
                <Button x:Name="MaximumPerformanceButton" Visibility="Collapsed" Click="MaximumPerformance_Click"/>
                <Button x:Name="SettingsToggleButton" Style="{StaticResource IconButton}" Margin="10,0,0,0" FontSize="16" Padding="8"
                        Content="&#xE713;" Click="SettingsToggle_Click" ToolTip="Mostrar ou ocultar a configuração"/>
            </StackPanel>
        </Grid>

        <!-- Aviso de preparação do TensorRT -->
        <Border Grid.Row="1" x:Name="TensorRtNotice" Visibility="Collapsed" Background="{StaticResource InfoSoftBrush}" BorderBrush="#2B4B6E"
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="20,0,20,10">
            <StackPanel>
                <TextBlock Text="Preparando TensorRT para sua placa de vídeo" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"/>
                <TextBlock x:Name="TensorRtNoticeText" TextWrapping="Wrap" Margin="0,3,0,8" Foreground="#C9DDF0" FontSize="12"/>
                <ProgressBar IsIndeterminate="True" Height="3" Foreground="{StaticResource InfoBrush}"/>
            </StackPanel>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Row="2" Margin="20,0,20,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                <!-- Episódio em andamento -->
                <Border x:Name="NowCard" Style="{StaticResource Card}" BorderBrush="#3A3270" Padding="18,14" Margin="0,0,0,12" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="NowLabel" Text="Processando agora" Foreground="{StaticResource AccentTextBrush}" FontSize="11.5"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="16,0,0,0"
                                       Text="{Binding StageSpeedText}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,4,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding FileName}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom"
                                       ToolTip="{Binding InputPath}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0:0.0}%}" FontSize="22" FontWeight="SemiBold" Margin="16,0,0,0"/>
                        </Grid>
                        <ProgressBar Grid.Row="2" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="8"/>
                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Decorrido " Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ElapsedText}"/>
                                <TextBlock Text="     Restante " Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding EtaText}"/>
                                <TextBlock Text="     Duração " Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding DurationText}"/>
                            </StackPanel>
                            <StackPanel x:Name="ResourceChips" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed"
                                        ToolTip="{Binding Text, ElementName=ResourceStatusText}">
                                <Border Style="{StaticResource Chip}"><TextBlock x:Name="CpuChipText" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/></Border>
                                <Border Style="{StaticResource Chip}"><TextBlock x:Name="RamChipText" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/></Border>
                                <Border Style="{StaticResource Chip}"><TextBlock x:Name="VramChipText" FontSize="11.5" Foreground="{StaticResource MutedBrush}"/></Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Fila -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="16,10,10,8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Fila" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="QueueCountText" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="10,2,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Click="AddFiles_Click" ToolTip="Adicione episódios a qualquer momento, inclusive durante o processamento. Também é possível arrastar arquivos para a fila.">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource IconLabel}"/><TextBlock Text="Adicionar arquivos"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="RemoveSelected_Click" ToolTip="Remover os episódios selecionados (exceto os em processamento)">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" Style="{StaticResource IconLabel}"/><TextBlock Text="Remover"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Click="Clear_Click" Content="Limpar" ToolTip="Limpar a fila"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid x:Name="QueueGrid" Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserSortColumns="False" CanUserReorderColumns="False" AllowDrop="True" DragOver="QueueGrid_DragOver" Drop="QueueGrid_Drop"
                                  SelectionMode="Extended" IsReadOnly="True" Margin="0,0,0,6">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="30" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock Text="⋮⋮" Cursor="SizeAll" FontSize="14" Foreground="{StaticResource SubtleBrush}" Padding="2,8" VerticalAlignment="Center"
                                                   ToolTip="Arraste para mudar a posição na fila" PreviewMouseLeftButtonDown="QueueHandle_MouseDown" PreviewMouseMove="QueueHandle_MouseMove"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="34" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock x:Name="Icon" Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource SubtleBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" ToolTip="{Binding Status}">
                                            <TextBlock.RenderTransform><RotateTransform/></TextBlock.RenderTransform>
                                        </TextBlock>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="done">
                                                <Setter TargetName="Icon" Property="Text" Value="&#xE73E;"/>
                                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="failed">
                                                <Setter TargetName="Icon" Property="Text" Value="&#xE783;"/>
                                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="warning">
                                                <Setter TargetName="Icon" Property="Text" Value="&#xE7BA;"/>
                                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="cancelled">
                                                <Setter TargetName="Icon" Property="Text" Value="&#xE711;"/>
                                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="running">
                                                <Setter TargetName="Icon" Property="Text" Value="&#xE895;"/>
                                                <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource AccentTextBrush}"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="Spin">
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetName="Icon" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                             From="0" To="360" Duration="0:0:2"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="Spin"/></DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Episódio" Width="*" MinWidth="220">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <StackPanel VerticalAlignment="Center" Margin="0,7" ToolTip="{Binding RowToolTip}">
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="Detail" Text="{Binding DetailText}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                            <ProgressBar Height="3" Margin="0,5,0,0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                                                         Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="running"><Setter TargetName="Detail" Property="Foreground" Value="{StaticResource AccentTextBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="failed"><Setter TargetName="Detail" Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="warning"><Setter TargetName="Detail" Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Duração" Width="78">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource MutedBrush}"/>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tamanho" Width="96">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock x:Name="Size" Text="{Binding SizeText}" ToolTip="{Binding SizeToolTip}" Foreground="{StaticResource MutedBrush}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasActualSize}" Value="True"><Setter TargetName="Size" Property="Foreground" Value="{StaticResource TextBrush}"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tempo" Width="96">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <TextBlock x:Name="Time" Text="{Binding TimeText}" ToolTip="{Binding TimeToolTip}" Foreground="{StaticResource MutedBrush}"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding StatusKind}" Value="running"><Setter TargetName="Time" Property="Foreground" Value="{StaticResource TextBrush}"/></DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="84" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right"
                                                    Visibility="{Binding CanOpenOutput, Converter={StaticResource BoolToVisibility}}">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Abrir vídeo final" IsEnabled="{Binding CanOpenOutput}" Click="OpenOutput_Click"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="Mostrar o vídeo final na pasta" IsEnabled="{Binding CanOpenOutput}" Click="OpenOutputFolder_Click"/>
                                        </StackPanel>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Estado vazio -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=QueueGrid}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Adicione episódios para começar" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock Text="Arraste arquivos de vídeo para cá ou use Adicionar arquivos." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Configuração -->
            <Border x:Name="SettingsPanel" Grid.Column="1" Style="{StaticResource Card}" Width="324" Margin="12,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,10,12,16">
                    <StackPanel>
                        <TextBlock Text="Configuração" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0"/>

                        <TextBlock Text="Processamento" Style="{StaticResource SectionLabel}"/>
                        <ComboBox x:Name="EngineCombo" DisplayMemberPath="Name" SelectionChanged="EngineCombo_SelectionChanged"/>

                        <TextBlock x:Name="ProfileLabel" Text="Shader / modelo" Style="{StaticResource SectionLabel}"/>
                        <ComboBox x:Name="ProfileCombo" DisplayMemberPath="Name" SelectionChanged="ProfileCombo_SelectionChanged"/>
                        <Border x:Name="LegacyProfileWarningPanel" Visibility="Collapsed" Background="{StaticResource WarningSoftBrush}" BorderBrush="#6E5427"
                                BorderThickness="1" CornerRadius="7" Padding="10,8" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock x:Name="LegacyProfileWarningTitle" Text="⚠ Perfil Legacy/Experimental" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"
                                           AutomationProperties.Name="Aviso Legacy/Experimental visível"/>
                                <TextBlock x:Name="LegacyProfileWarningText" Foreground="#E7D3A9" TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Qualidade (CQ)" Style="{StaticResource SectionLabel}"/>
                                <TextBox x:Name="CqText" Text="18" HorizontalContentAlignment="Center" TextChanged="Settings_Changed"
                                         ToolTip="Menor = mais qualidade e arquivos maiores."/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Text="Saída" Style="{StaticResource SectionLabel}"/>
                                <TextBlock Text="AV1 10-bit • MKV" Margin="0,6,0,0" ToolTip="{Binding Text, ElementName=CompatibilitySummaryText}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="CompatibilitySummaryText" Visibility="Collapsed"
                                   Text="AV1 Main 10-bit, 4K, MKV e AAC 48 kHz. Legendas ASS podem exigir transcodificação."/>

                        <TextBlock Text="Pasta de saída" Style="{StaticResource SectionLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="OutputDirectoryText" ToolTip="Vazio = mesma pasta do arquivo original" TextChanged="Settings_Changed"/>
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE838;" Margin="6,0,0,0" Click="ChooseOutput_Click"
                                    BorderBrush="{StaticResource BorderStrongBrush}" ToolTip="Escolher pasta"/>
                        </Grid>
                        <TextBlock x:Name="OutputDiskSpaceText" Text="Espaço livre: aguardando pasta" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                        <TextBlock x:Name="EstimateSummaryText" Text="Estimativa: aguardando arquivos" Style="{StaticResource Caption}" Margin="0,3,0,0"/>

                        <TextBlock Text="Parâmetros do encoder" Style="{StaticResource SectionLabel}"/>
                        <StackPanel x:Name="BetaPanel">
                            <CheckBox x:Name="BetaAqStrengthCheck" IsChecked="True" Content="AQ strength 10" Margin="0,0,0,8" Click="BetaOption_Click"
                                      ToolTip="Aumenta a força da alocação adaptativa espacial. Pode preservar detalhes em cenas difíceis, mas tende a aumentar o tamanho do arquivo."/>
                            <CheckBox x:Name="BetaBAdaptCheck" IsChecked="True" Content="B-adapt" Click="BetaOption_Click"
                                      ToolTip="Permite ao encoder decidir melhor a estrutura de frames B. Pode melhorar eficiência, com pequeno custo de análise."/>
                        </StackPanel>

                        <TextBlock Text="Teste de qualidade" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="Use Testar trecho para comparar 15 s de vídeo e estimar tempo e tamanho antes de processar tudo.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Visibility, ElementName=PilotSummaryPanel}" Value="Visible"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Border x:Name="PilotSummaryPanel" Visibility="Collapsed" Background="{StaticResource InfoSoftBrush}" BorderBrush="#2B4B6E"
                                BorderThickness="1" CornerRadius="7" Padding="10">
                            <StackPanel>
                                <TextBlock x:Name="PilotSummaryText" Foreground="#D7E9F8" TextWrapping="Wrap" FontSize="12"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="ComparePilotButton" Content="Comparar" IsEnabled="False" Click="ComparePilot_Click" Padding="10,5" Margin="0,0,6,0"
                                            ToolTip="Comparar o original e o resultado no mesmo quadro"/>
                                    <Button x:Name="OpenPilotButton" Content="Abrir amostra" Style="{StaticResource GhostButton}" Padding="10,5" Click="OpenPilot_Click"/>
                                </WrapPanel>
                                <TextBlock Text="Tempo com margem de ±15%; a preparação da engine é feita antes da medição." Foreground="#96AEC2"
                                           TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Avançado" Style="{StaticResource SectionLabel}"/>
                        <CheckBox x:Name="AdvancedModeCheck" Content="Comando FFmpeg personalizado" Click="AdvancedMode_Click"
                                  ToolTip="Modo avançado: edita o comando FFmpeg. No AnimeJaNai, usa o fluxo contínuo e desativa a retomada por blocos."/>
                        <Border x:Name="AdvancedPanel" Visibility="Collapsed" Background="{StaticResource WarningSoftBrush}" BorderBrush="#6E5427"
                                BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Use {INPUT} e {OUTPUT} como marcadores" Foreground="{StaticResource WarningBrush}" FontSize="12"/>
                                <TextBox x:Name="AdvancedCommandText" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="90" MaxHeight="180"
                                         Margin="0,7,0,0" FontFamily="Consolas" FontSize="11" VerticalContentAlignment="Top" TextChanged="AdvancedCommandText_Changed"/>
                                <TextBlock Text="O ffmpeg.exe permanece fixo. No AnimeJaNai, o Modo avançado usa o fluxo contínuo e desativa a retomada por blocos."
                                           Foreground="#D5B979" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Sempre desabilitado no código (um vídeo por vez); mantido para compatibilidade. -->
                        <ComboBox x:Name="ConcurrencyCombo" SelectedIndex="1" Visibility="Collapsed">
                            <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/>
                        </ComboBox>
                        <TextBlock x:Name="ResourceStatusText" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Barra de ações -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="20,12,20,0" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="OverallPercentText" Text="0%" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Grid.Column="1" x:Name="OverallStatusText" Text="Pronto para começar" Foreground="{StaticResource MutedBrush}" Margin="10,1,12,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock Grid.Column="2" x:Name="QueueElapsedText" Text="Tempo acumulado da fila: 00:00" Foreground="{StaticResource MutedBrush}" Margin="0,1,0,0"/>
                    </Grid>
                    <ProgressBar x:Name="OverallProgress" Margin="0,8,0,0" Maximum="100" Height="6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <Button x:Name="LogsButton" Style="{StaticResource GhostButton}" Click="OpenLogs_Click" ToolTip="Abrir a pasta de logs">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F9;" Style="{StaticResource IconLabel}"/><TextBlock Text="Logs"/></StackPanel>
                    </Button>
                    <Button x:Name="PilotButton" Margin="8,0,0,0" Click="Pilot_Click"
                            ToolTip="Gera três trechos de 5 segundos para comparar a qualidade e estimar o tempo e o tamanho do episódio completo.">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" Style="{StaticResource IconLabel}"/><TextBlock Text="Testar trecho"/></StackPanel>
                    </Button>
                    <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="18,7" Click="Start_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE768;" Style="{StaticResource IconLabel}"/><TextBlock Text="Iniciar fila"/></StackPanel>
                    </Button>
                    <Button x:Name="CancelButton" Content="Cancelar" IsEnabled="False" Margin="8,0,0,0" Click="Cancel_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Linha de status -->
        <TextBlock Grid.Row="4" x:Name="FooterText" Foreground="{StaticResource SubtleBrush}" FontSize="11.5" Margin="22,8,22,10" TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                   Text="Arquivos temporários usam .partial.mkv e o original nunca é alterado."/>
    </Grid>
</Window>
